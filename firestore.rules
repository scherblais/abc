rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each authenticated user can only read/write under their own UID.
    // Bookings, invoices, companies, agents, services, and the settings
    // doc all live under users/{uid}/...
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
