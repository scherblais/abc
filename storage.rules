rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Each authenticated user can only read / write under their own UID.
    // Receipt photos for expenses live at users/{uid}/receipts/{expenseId}/...
    match /users/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId
                         // Cap individual uploads at 10 MB after client-side
                         // resize. Phone photos compress to well under this.
                         && (request.resource == null || request.resource.size < 10 * 1024 * 1024);
    }
  }
}
